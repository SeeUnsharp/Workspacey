{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "process",
            "command": "dotnet",
            "args": ["build", "${workspaceFolder}/Workspacey.slnx", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "test",
            "type": "process",
            "command": "dotnet",
            "args": ["test", "${workspaceFolder}/Workspacey.slnx"],
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build AppImage",
            "type": "process",
            "command": "${workspaceFolder}/packaging/appimage/build-appimage.sh",
            "group": "build",
            "problemMatcher": "$msCompile"
        }
    ]
}
