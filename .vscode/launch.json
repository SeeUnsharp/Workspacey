{
    // Requires the C# / C# Dev Kit extension (ms-dotnettools.csharp).
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Workspacey: settings window",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/Workspacey.App/bin/Debug/net10.0/workspacey.dll",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "Workspacey: pick window (--pick)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/Workspacey.App/bin/Debug/net10.0/workspacey.dll",
            "args": ["--pick"],
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "stopAtEntry": false
        }
    ]
}
